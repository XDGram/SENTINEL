# Copy to .env.local and fill in. Never commit real keys.

# SERV Reasoning (https://console.openserv.ai)
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Reppo Evaluation API (https://eval.reppo.xyz -> API Key)
REPPO_API_KEY=
# Settlement window in minutes: 10, 15, 30, 60, ...
REPPO_SETTLEMENT_MINUTES=10
# Safety cap on evaluations from the public demo (each costs credits)
REPPO_MAX_SUBMISSIONS=6

# Supabase (threat memory)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web search for community reports (Reddit, YouTube, X, blogs). Set ONE of:
TAVILY_API_KEY=
BRAVE_API_KEY=

# Protects the scheduled intel sweep (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
