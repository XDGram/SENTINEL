# Copy to .env.local and fill in. Never commit real keys.

# SERV Reasoning (https://console.openserv.ai)
SERV_API_KEY=
SERV_MODEL=gpt-6-luna
# Cap on SERV calls per day per server instance (protects the credit budget)
SERV_MAX_CALLS_PER_DAY=300

# Reppo Evaluation API (https://eval.reppo.xyz -> API Key)
REPPO_API_KEY=
# Safety cap on evaluations from the public demo (each costs credits)
REPPO_MAX_SUBMISSIONS=6

# Supabase (threat memory)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Or, instead of the service key: the publishable key + a server-only secret
# whose SHA-256 is stored in private.app_key (see the app_key_access migration)
SUPABASE_PUBLISHABLE_KEY=
SENTINEL_DB_KEY=

# Web search for community reports (Reddit, YouTube, X, blogs). Set ONE of:
TAVILY_API_KEY=
BRAVE_API_KEY=

# Protects the scheduled intel sweep (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
